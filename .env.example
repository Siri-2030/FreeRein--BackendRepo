# Copy to .env (never commit .env). Same names work as hosting-platform environment variables.

# --- Database (pick ONE style) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/FreeRein_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password
# or a single URL from your host (Render/Heroku style) - auto-converted:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Security ---
JWT_SECRET=put-a-long-random-string-of-32+-characters-here
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# --- Demo data ---
SEED_DEMO_USERS=true
ADMIN_EMAIL=admin@freerein.demo
ADMIN_PASSWORD=Admin@12345
DEMO_PASSWORD=Demo@12345
